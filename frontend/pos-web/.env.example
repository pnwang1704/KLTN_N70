# ==============================================================================
# BIẾN MÔI TRƯỜNG CHO POS WEB (VERCEL DEPLOYMENT & NGROK)
# Hướng dẫn: Thêm các biến này vào mục "Environment Variables" trên Vercel Project Settings
# ==============================================================================

# URL duy nhất của API Gateway (Ví dụ qua ngrok: https://xxxx.ngrok-free.app hoặc VPS: https://api.yourdomain.com)
VITE_API_GATEWAY_URL=https://your-ngrok-domain.ngrok-free.app

# URL của Socket.IO Server (TÙY CHỌN: Nếu không cấu hình, frontend sẽ TỰ ĐỘNG tái sử dụng domain của VITE_API_GATEWAY_URL)
# Chỉ cần đặt khi bạn muốn chạy Socket.IO trên một subdomain/port riêng biệt.
# VITE_SOCKET_URL=https://your-ngrok-domain.ngrok-free.app
