# ==============================================================================
# BIẾN MÔI TRƯỜNG PRODUCTION CHO VPS (BACKEND & DATABASE)
# Hướng dẫn: Copy file này thành .env trên VPS và điền các giá trị bảo mật
# Lệnh: cp .env.production.example .env
# ==============================================================================

# Cổng mở ra ngoài Host VPS
API_GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3004
RABBITMQ_MANAGEMENT_PORT=15672

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_strong_postgres_password_here

# Cấu hình Message Broker RabbitMQ
RABBITMQ_DEFAULT_USER=fnb_admin
RABBITMQ_DEFAULT_PASS=your_super_strong_rabbitmq_password_here

# Khóa bí mật ký phát và giải mã JWT Token (Ít nhất 32 ký tự ngẫu nhiên)
JWT_SECRET=your_super_secret_jwt_key_random_string_here_32chars

# Danh sách Domain Frontend được phép gọi qua CORS (phân tách bởi dấu phẩy nếu có nhiều domain)
# Ví dụ: https://pos-web.vercel.app,https://pos-web-git-main-yourname.vercel.app
FRONTEND_URL=https://your-pos-project.vercel.app

# Cấu hình Cổng thanh toán VietQR PayOS (Tùy chọn)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
